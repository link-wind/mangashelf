# Worker 镜像：Java 运行层 + Python OCR/嗅探环境（同一 Ubuntu 基底，构建期联网、运行期零联网）。
# 注意：venv 不得跨基底复制（symlink 悬空 + glibc 差异），Python 环境直接装在与
# Java 相同的 ubuntu noble 层；requirements 不变时依赖层走构建缓存。
FROM eclipse-temurin:25-jre-noble
WORKDIR /opt/app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg python3 python3-venv python3-pip \
 && rm -rf /var/lib/apt/lists/*
# 依赖层：OCR venv + RapidOCR 模型 + Playwright Chromium。模型/浏览器缓存放
# /opt 固定路径（HOME 指向 /opt/ocr-home），运行用户 1000 可读，不依赖 root HOME。
COPY processing/requirements.txt /tmp/requirements.txt
RUN mkdir -p /opt/ocr-home /opt/ms-playwright /opt/data/jobs \
 && HOME=/opt/ocr-home python3 -m venv /opt/ocr-venv \
 && HOME=/opt/ocr-home /opt/ocr-venv/bin/pip install --no-cache-dir \
      -r /tmp/requirements.txt rapidocr onnxruntime playwright \
 && HOME=/opt/ocr-home /opt/ocr-venv/bin/python -c "from rapidocr import RapidOCR; RapidOCR()" \
 && HOME=/opt/ocr-home PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
      /opt/ocr-venv/bin/python -m playwright install --with-deps chromium \
 && chown -R 1000:1000 /opt/ocr-home /opt/ms-playwright /opt/data/jobs
COPY processing /opt/processing
COPY server/target/mangashelf-server-0.1.0-SNAPSHOT.jar app.jar
ENV MANGASHELF_PYTHON=/opt/ocr-venv/bin/python \
    MANGASHELF_PROCESSING_ROOT=/opt/processing \
    MANGASHELF_WORK_ROOT=/opt/data/jobs \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    HOME=/opt/ocr-home
USER 1000
ENTRYPOINT ["java", "-jar", "app.jar", "--mangashelf.role=worker"]
