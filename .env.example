# GemiNeko（杰米猫）本地环境占位配置（DESIGN 第 19 节）
# 复制为 .env 后按需修改；.env 不入库。compose.yaml 与 server/application.yml 读取。

# ── PostgreSQL ──
POSTGRES_USER=mangashelf
POSTGRES_PASSWORD=mangashelf
POSTGRES_DB=mangashelf
POSTGRES_PORT=5432

# ── RabbitMQ ──
RABBITMQ_AMQP_PORT=5672
RABBITMQ_HTTP_PORT=15672

# ── S3 兼容对象存储（开发用 SeaweedFS；MinIO 镜像已撤下，见 docs/validation/m0.md）──
S3_PORT=9000
S3_CONSOLE_PORT=9333
S3_ACCESS_KEY=mangashelf
S3_SECRET_KEY=mangashelf-secret
S3_BUCKET=mangashelf

# ── server 侧配置（application.yml 从环境读取）──
# 平台来源标识（接入协议清单使用；部署时固定，不随域名变化）
MANGASHELF_PLATFORM_ID=mangashelf-instance-local
# 首次启动引导管理员密码；已有账号密码不会被覆盖。生产环境必须改成强密码。
MANGASHELF_ADMIN_PASSWORD=change-me-before-first-boot
MANGASHELF_DB_URL=jdbc:postgresql://localhost:5432/mangashelf
MANGASHELF_RABBITMQ_ADDRESSES=localhost:5672
MANGASHELF_S3_ENDPOINT=http://localhost:9000
MANGASHELF_S3_REGION=us-east-1
# 签名地址有效期（秒），短有效期是明确的安全边界
MANGASHELF_PRESIGN_TTL_SECONDS=600

# 上传与处理预算（DESIGN 10.3 / 19）
MANGASHELF_UPLOAD_MAX_BYTES=524288000
MANGASHELF_IMAGE_MAX_PIXELS=8000000
MANGASHELF_ARCHIVE_MAX_ENTRIES=2000

# 处理并发与任务超时
MANGASHELF_CONTENT_PROCESS_CONCURRENCY=2
MANGASHELF_CONTENT_INDEX_CONCURRENCY=1
MANGASHELF_JOB_LEASE_SECONDS=120

# Python 处理任务：必须使用绝对路径（Worker 可能从任意目录启动）
# venv 创建：python3 -m venv processing/.venv && processing/.venv/bin/pip install -r processing/requirements.txt
# MANGASHELF_PYTHON=/absolute/path/to/mangashelf/processing/.venv/bin/python
# MANGASHELF_PROCESSING_ROOT=/absolute/path/to/mangashelf
# MANGASHELF_WORK_ROOT=/absolute/path/to/mangashelf/data/jobs

# ── Embedding（M4 前保持未配置；缺失时语义检索入口明确标记不可用）──
# MANGASHELF_EMBEDDING_MODEL=
# MANGASHELF_EMBEDDING_DIMENSIONS=
# MANGASHELF_EMBEDDING_API_KEY=
# 拷贝详情与目录使用官方 v3 API：留空直连；受限出口可显式配置代理，容器使用容器可达地址。
MANGASHELF_COPYMANGA_PROXY=
# 拷贝搜索与章节图片仍使用浏览器；部分章节需登录，两者其一即可
# 1) 本机运行 processing/.venv/bin/python -m processing.manga_login 生成登录态文件
MANGASHELF_COPYMANGA_STORAGE_STATE=
# 2) 或直接填浏览器 Cookie 串（k=v; k2=v2）
MANGASHELF_COPYMANGA_COOKIE=

# 其他浏览器漫画源可选代理；容器请填写容器可达的地址。
MANGASHELF_BROWSER_PROXY=

# 哔哩 HTTP 独立网络配置：留空显式直连，不继承浏览器或系统代理。
MANGASHELF_BILIBILI_PROXY=
# 缓存默认位于 work-root 的同级 bilibili-http-cache；全栈使用独立持久卷。
# MANGASHELF_BILIBILI_CACHE_ROOT=/absolute/path/to/bilibili-http-cache
MANGASHELF_BILIBILI_CACHE_MAX_BYTES=536870912
MANGASHELF_BILIBILI_DETAIL_TTL_SECONDS=1800
MANGASHELF_BILIBILI_INDEX_TTL_SECONDS=600
MANGASHELF_BILIBILI_IMAGE_TTL_SECONDS=604800

MANGASHELF_BANGUMI_ENABLED=true
MANGASHELF_BANGUMI_PROXY=

# ── 注册邮箱验证码（标准 SMTP；Resend / QQ / 163 / Gmail 均支持）──
# 开启后注册页要求填写邮箱与 6 位验证码，且支持邮箱或用户名登录。
# Resend 示例：HOST=smtp.resend.com, PORT=465, SSL=true, USERNAME=resend, PASSWORD=re_xxx, FROM="GemiNeko <noreply@your.domain>"
# QQ 邮箱示例：HOST=smtp.qq.com, PORT=465, SSL=true, USERNAME=123456@qq.com, PASSWORD=16位授权码, FROM=123456@qq.com
MANGASHELF_MAIL_ENABLED=false
MANGASHELF_MAIL_HOST=
MANGASHELF_MAIL_PORT=465
MANGASHELF_MAIL_SSL=true
MANGASHELF_MAIL_STARTTLS=false
MANGASHELF_MAIL_USERNAME=
MANGASHELF_MAIL_PASSWORD=
MANGASHELF_MAIL_FROM=
